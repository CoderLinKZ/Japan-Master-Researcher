# Required: use credentials from your selected Anthropic-compatible provider.
ANTHROPIC_API_KEY=replace-with-your-api-key
MODEL_ID=replace-with-your-model-id
# Optional per-request model timeout in seconds, 1–120 (default: 60).
# MODEL_TIMEOUT_SECONDS=60

# Optional: only set this when using an Anthropic-compatible provider endpoint.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: OpenAlex supports basic requests without a key; a free key provides
# a larger request budget and is recommended for normal use.
# OPENALEX_API_KEY=replace-with-your-openalex-api-key

# Optional: same SerpApi Google search API as Hello-Agent/search_tool.py.
# Recommended for automatic discovery of Japanese professor/laboratory sites.
# SERPAPI_API_KEY=replace-with-your-serpapi-api-key

# Optional fallback when SERPAPI_API_KEY is absent.
# BRAVE_API_KEY=replace-with-your-brave-api-key

# Optional for startup, required for real KAKEN OpenSearch retrieval.
# Register a CiNii API Application ID; without it the KAKEN tool returns a
# structured blocked result and the workflow keeps an explicit degradation.
# KAKEN_APP_ID=replace-with-your-cinii-application-id

# Required for durable LangGraph checkpoints. This example connects through
# the local PostgreSQL Unix socket without embedding a password.
DATABASE_URL=postgresql:///jmr_langgraph?host=/tmp&user=jmr_app

# Required by the FastAPI boundary. Keys are opaque bearer tokens and values
# are the trusted user IDs they represent. Generate long random tokens and
# inject this value through a secret manager in production.
# JMR_API_TOKENS_JSON='{"local-dev-token-change-me":"root"}'

# Optional HTTP settings. CORS is disabled unless an explicit origin list is
# configured. The current in-process per-Case lock requires one API worker.
# JMR_CORS_ORIGINS_JSON=["http://localhost:5173"]
# JMR_API_MAX_CONCURRENT_RUNS=4
# JMR_API_HOST=127.0.0.1
# JMR_API_PORT=8000

# Restrict checkpoint deserialization to LangGraph's known-safe types.
LANGGRAPH_STRICT_MSGPACK=true

# Optional local paths. Production deployments should use persistent,
# access-controlled mounts and a managed log sink.
# JMR_OBJECT_STORE_DIR=.jmr/objects
# JMR_EVENT_LOG_PATH=.jmr/events.jsonl

# The readiness command reads JMR_OBJECT_STORE_ROOT rather than the CLI name.
# Set it to the same absolute directory as JMR_OBJECT_STORE_DIR before probing.
# JMR_OBJECT_STORE_ROOT=/absolute/path/to/jmr/objects
